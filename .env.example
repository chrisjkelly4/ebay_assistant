ANTHROPIC_API_KEY=

# Set to true for sandbox, remove or set to false for production
EBAY_SANDBOX=true

# eBay developer credentials (from developer.ebay.com)
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=

# RuName from developer portal (User Tokens → OAuth → Add redirect URL → http://localhost:8080/)
EBAY_RUNAME=

# OAuth user token (populated by: python -m src.cli setup)
EBAY_REFRESH_TOKEN=

# Business policy IDs (from seller account > Business policies)
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_FULFILLMENT_POLICY_ID=

# Inventory location key (from Sell Inventory API setup)
EBAY_MERCHANT_LOCATION_KEY=
